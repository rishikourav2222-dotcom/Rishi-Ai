<style>
*{
  box-sizing:border-box;
}

body{
  margin:0;
  font-family:Arial,sans-serif;
  min-height:100vh;
  background:linear-gradient(135deg,#4facfe,#764ba2);
  display:flex;
  justify-content:center;
  align-items:center;
  padding:15px;
}

.game{
  width:100%;
  max-width:500px;
  background:white;
  border-radius:25px;
  padding:22px;
  box-shadow:0 10px 35px rgba(0,0,0,.3);
}

h1{
  text-align:center;
  margin:5px 0 20px;
}

.center{
  text-align:center;
}

.levels{
  display:grid;
  gap:12px;
}

.level{
  border:0;
  border-radius:15px;
  padding:18px;
  font-size:18px;
  font-weight:bold;
  cursor:pointer;
}

.easy{
  background:#b8f2c2;
}

.medium{
  background:#ffe08a;
}

.hard{
  background:#ffaaa5;
}

.locked{
  opacity:.5;
  cursor:not-allowed;
}

.info{
  display:flex;
  justify-content:space-between;
  font-weight:bold;
  margin-bottom:15px;
}

.timer{
  text-align:center;
  font-size:22px;
  font-weight:bold;
  margin:10px;
}

.question{
  font-size:22px;
  font-weight:bold;
  margin:25px 0;
  line-height:1.4;
}

.options{
  display:grid;
  gap:12px;
}

.option{
  width:100%;
  padding:15px;
  border:2px solid #ddd;
  border-radius:12px;
  background:#f7f7f7;
  font-size:17px;
  text-align:left;
  cursor:pointer;
}

.option:hover{
  background:#e9f4ff;
}

.correct{
  background:#9be7a5 !important;
  border-color:#219653;
}

.wrong{
  background:#ffaaa5 !important;
  border-color:#d63031;
}

button:disabled{
  cursor:not-allowed;
}

.next{
  width:100%;
  margin-top:18px;
  padding:15px;
  border:0;
  border-radius:12px;
  background:#4facfe;
  color:white;
  font-size:18px;
  font-weight:bold;
}

.hidden{
  display:none;
}

.result{
  text-align:center;
}

.result h2{
  font-size:28px;
}

.restart{
  width:100%;
  padding:15px;
  border:0;
  border-radius:12px;
  background:#222;
  color:white;
  font-size:18px;
  font-weight:bold;
  margin-top:15px;
}
</style>
</head>

<body>

