<div class="center">
<p>Choose your level</p>
<p>🎯 Total Questions: 100</p>
</div>

<div class="levels">

<button class="level easy" onclick="startLevel(1)">
🟢 LEVEL 1 - EASY
<br>
50 Questions • 60 Seconds
</button>

<button id="level2Button"
class="level medium locked"
onclick="startLevel(2)"
disabled>
🔒 LEVEL 2 - MEDIUM
<br>
30 Questions • 45 Seconds
</button>

<button id="level3Button"
class="level hard locked"
onclick="startLevel(3)"
disabled>
🔒 LEVEL 3 - HARD
<br>
20 Questions • 30 Seconds
</button>

</div>

</div>


<!-- QUIZ SCREEN -->

<div id="quiz" class="hidden">

<div class="info">

<span>
Level <span id="levelNumber">1</span>
</span>

<span>
Score: <span id="score">0</span>
</span>

</div>

<div class="info">

<span>
Question <span id="questionNumber">1</span>
</span>

<span>
Total <span id="totalQuestions">50</span>
</span>

</div>

<div class="timer">
⏱️ <span id="time">60</span>
</div>

<div class="question" id="question">
Question
</div>

<div class="options" id="options"></div>

<button
class="next hidden"
id="nextButton"
onclick="nextQuestion()">
➡️ Next Question
</button>

</div>


<!-- RESULT SCREEN -->

<div id="result" class="result hidden">

<h1>🎉 Level Complete!</h1>

<h2 id="resultTitle"></h2>

<p>
🏆 Score: <b id="finalScore">0</b>
</p>

<p>
✅ Correct: <b id="correctCount">0</b>
</p>

<p>
❌ Wrong: <b id="wrongCount">0</b>
</p>

<button
id="continueButton"
class="next"
onclick="continueGame()">
➡️ Continue
</button>

<button
class="restart"
onclick="goHome()">
🏠 Home
</button>

</div>

</div>


