/* =========================
   GAME VARIABLES
========================= */

let currentLevel = 1;
let currentQuestions = [];
let currentIndex = 0;
let score = 0;
let correct = 0;
let wrong = 0;
let timeLeft = 60;
let timer;
let answered = false;

function startLevel(level){

  currentLevel = level;

  if(level === 1){
    currentQuestions = easyQuestions;
    timeLeft = 60;
  }

  if(level === 2){
    currentQuestions = mediumQuestions;
    timeLeft = 45;
  }

  if(level === 3){
    currentQuestions = hardQuestions;
    timeLeft = 30;
  }

  currentIndex = 0;
  score = 0;
  correct = 0;
  wrong = 0;

  document.getElementById("home")
    .classList.add("hidden");

  document.getElementById("result")
    .classList.add("hidden");

  document.getElementById("quiz")
    .classList.remove("hidden");

  document.getElementById("levelNumber")
    .innerText = level;

  document.getElementById("totalQuestions")
    .innerText = currentQuestions.length;

  document.getElementById("score")
    .innerText = score;

  showQuestion();
}


function showQuestion(){

  clearInterval(timer);

  answered = false;

  let q = currentQuestions[currentIndex];

  document.getElementById("questionNumber")
    .innerText = currentIndex + 1;

  document.getElementById("question")
    .innerText = q.q;

  let options =
    document.getElementById("options");

  options.innerHTML = "";

  q.o.forEach(function(option,index){

    let button =
      document.createElement("button");

    button.className = "option";

    button.innerText =
      String.fromCharCode(65 + index) +
      ". " + option;

    button.onclick = function(){

      selectAnswer(index,button);

    };

    options.appendChild(button);

  });

  document.getElementById("nextButton")
    .classList.add("hidden");

  if(currentLevel === 1){
    timeLeft = 60;
  }

  if(currentLevel === 2){
    timeLeft = 45;
  }

  if(currentLevel === 3){
    timeLeft = 30;
  }

  document.getElementById("time")
    .innerText = timeLeft;

  timer = setInterval(function(){

    timeLeft--;

    document.getElementById("time")
      .innerText = timeLeft;

    if(timeLeft <= 0){

      clearInterval(timer);

      wrong++;

      disableOptions();

      document.getElementById("nextButton")
        .classList.remove("hidden");

    }

  },1000);
}


function selectAnswer(index,button){

  if(answered){
    return;
  }

  answered = true;

  clearInterval(timer);

  let q = currentQuestions[currentIndex];

  let allOptions =
    document.querySelectorAll(".option");

  allOptions.forEach(function(btn){
    btn.disabled = true;
  });

  if(index === q.a){

    button.classList.add("correct");

    correct++;

    score += 10;

    document.getElementById("score")
      .innerText = score;

  }else{

    button.classList.add("wrong");

    wrong++;

    allOptions[q.a]
      .classList.add("correct");
  }

  document.getElementById("nextButton")
    .classList.remove("hidden");
}


function disableOptions(){

  let q = currentQuestions[currentIndex];

  let allOptions =
    document.querySelectorAll(".option");

  allOptions.forEach(function(btn){
    btn.disabled = true;
  });

  allOptions[q.a]
    .classList.add("correct");
}


function nextQuestion(){

  currentIndex++;

  if(currentIndex >= currentQuestions.length){

    finishLevel();

  }else{

    showQuestion();

  }
}


function finishLevel(){

  clearInterval(timer);

  document.getElementById("quiz")
    .classList.add("hidden");

  document.getElementById("result")
    .classList.remove("hidden");

  document.getElementById("resultTitle")
    .innerText =
    "Level " + currentLevel + " Complete!";

  document.getElementById("finalScore")
    .innerText = score;

  document.getElementById("correctCount")
    .innerText = correct;

  document.getElementById("wrongCount")
    .innerText = wrong;

  let continueButton =
    document.getElementById("continueButton");

  if(currentLevel === 1){

    continueButton.innerText =
      "🔓 Unlock Level 2";

    continueButton.disabled = false;

  }else if(currentLevel === 2){

    continueButton.innerText =
      "🔓 Unlock Level 3";

    continueButton.disabled = false;

  }else{

    continueButton.innerText =
      "🎉 All Levels Complete!";

    continueButton.disabled = true;
  }
}


function continueGame(){

  if(currentLevel === 1){

    document.getElementById("level2Button")
      .disabled = false;

    document.getElementById("level2Button")
      .classList.remove("locked");

    document.getElementById("result")
      .classList.add("hidden");

    document.getElementById("home")
      .classList.remove("hidden");

  }

  else if(currentLevel === 2){

    document.getElementById("level3Button")
      .disabled = false;

    document.getElementById("level3Button")
      .classList.remove("locked");

    document.getElementById("result")
      .classList.add("hidden");

    document.getElementById("home")
      .classList.remove("hidden");

  }
}


function goHome(){

  clearInterval(timer);

  document.getElementById("quiz")
    .classList.add("hidden");

  document.getElementById("result")
    .classList.add("hidden");

  document.getElementById("home")
    .classList.remove("hidden");
}

